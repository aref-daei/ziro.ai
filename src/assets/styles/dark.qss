QMainWindow {
    background: #060C06;
    color: #F0F2F0;
}

QPushButton {
    background: #54C750;
    color: #1E1E1E;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
}

QPushButton:hover {
    background: #6FD96C;
}

#TitleBar {
    background-color: #060C06;
    border-bottom: 1px solid #2D2D2D;
}

#LogoLabel {
    padding: 0px 15px 0px 15px;
}

#MenuButton {
    background: transparent;
    color: #F0F2F0;
    font-size: 13px;
    border-radius: 0px;
    padding: 12px 10px;
}

#Notice {
    color: #9A9472;
    background: transparent;
    border: 1px solid #9A9472;
    border-radius: 15px;
    padding: 0px 14px;
    margin: 6px 10px 6px 10px;
}

#DeviceLabel {
    color: #9A9A9A;
    background: transparent;
    border: 1px solid #9A9A9A;
    border-radius: 15px;
    padding: 0px 14px;
    margin: 6px 20px 6px 10px;
}

#MinButton, #MaxButton, #CloseButton {
    background: transparent;
    border-radius: 0px;
    padding: 0px;
}

#MenuButton:hover, #MinButton:hover, #MaxButton:hover {
    background-color: #2D2D2D;
}

#CloseButton:hover {
    background-color: #E81123;
}

#panel {
    background: #1E1E1E;
    border: 1px solid #2D2D2D;
    border-radius: 6px;
}

#panelTitle {
    color: #F0F2F0;
    font-size: 15px;
    font-weight: bold;
}

#addButton {
    padding: 4px 8px;
}

QSplitter::handle {
    background: transparent;
}

#Stop {
    padding-right: 60px;
    padding-left: 60px;
}

#OpenOutput {
    background: transparent;
    color: #54C750;
    border: 1px solid #54C750;
}

#OpenOutput:hover {
    background: #193D18;
}

#Logs {
    background: #F0F2F0;
}

#Logs:hover {
    background: #CBCECB;
}
