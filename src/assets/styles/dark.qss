QMainWindow {
    background: #060C06;
    color: #F0F2F0;
}

QPushButton {
    background: #54C750;
    color: #1E1E1E;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
}

QPushButton:hover {
    background: #6FD96C;
}

#TitleBar {
    background-color: #060C06;
    border-bottom: 1px solid #2D2D2D;
}

#LogoLabel {
    padding: 0px 6px 0px 10px;
}

#MenuButton {
    background: transparent;
    padding: 8px 8px;
}

#MinButton, #MaxButton, #CloseButton {
    background: transparent;
    border-radius: 0px;
    padding: 0px;
}

#MenuButton:hover, #MinButton:hover, #MaxButton:hover {
    background-color: #2D2D2D;
}

#CloseButton:hover {
    background-color: #E81123;
}

#panel {
    background: #1E1E1E;
    border: 1px solid #2D2D2D;
    border-radius: 6px;
}

#panelTitle {
    color: #F0F2F0;
    font-size: 15px;
    font-weight: bold;
}

#addButton {
    padding: 4px 8px;
}

QSplitter::handle {
    background: transparent;
}
