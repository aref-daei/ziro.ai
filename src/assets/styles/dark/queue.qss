QFrame#InspectorRow {
    background-color: #3E3F3E;
    border-radius: 10px;
}

#InspectorLabel {
    color: #dddddd;
    font-size: 12px;
    font-weight: 600;
}

#QueueStatusLabel {
    font-size: 11px;
}

#QueueProgressBar {
    background-color: #2a2a2a;
    border: none;
    border-radius: 3px;
}

#QueueProgressBar::chunk {
    background-color: #54C750;
    border-radius: 3px;
}

#QueueScrollArea {
    background-color: transparent;
    border: none;
}

#ListContainer {
    background-color: transparent;
}
