QMainWindow {
    background: #060C06;
    color: #F0F2F0;
    font-size: 13px;
}

QPushButton {
    background: #54C750;
    color: #1E1E1E;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
}
QPushButton:hover {
    background: #6FD96C;
}
QPushButton:disabled {
    background-color: #58AD55;
}

QSplitter::handle {
    background: transparent;
}
