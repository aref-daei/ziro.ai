#PreviewVideoWidget {
    background-color: #000000;
    border-radius: 8px;
}
#PreviewEmptyLabel {
    color: #888888;
    font-size: 13px;
}
#PreviewPlayButton {
    background-color: #54C750;
    border: none;
    border-radius: 16px;
}
#PreviewPlayButton:hover {
    background: #6FD96C;
}
#PreviewPlayButton:disabled {
    background-color: #58AD55;
}
#PreviewTimeLabel {
    color: #dddddd;
    font-size: 12px;
}
#PreviewSlider {
    height: 14px;
}
#PreviewSlider::groove:horizontal {
    height: 4px;
    background-color: #3E3F3E;
    border-radius: 2px;
}
#PreviewSlider::sub-page:horizontal {
    background-color: #54C750;
    border-radius: 2px;
}
#PreviewSlider::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -4px 0;
    background-color: #f0f2f0;
    border-radius: 6px;
}
